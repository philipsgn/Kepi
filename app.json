{
  "expo": {
    "name": "PigFly",
    "slug": "pigfly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "kepi",
      "vilocket"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kepi.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PigFly sử dụng Camera để bạn chụp lại ảnh khoảnh khắc chi tiêu và nuôi chú heo lớn mỗi ngày.",
        "NSPhotoLibraryUsageDescription": "PigFly cần quyền truy cập ảnh để bạn tải ảnh hóa đơn chi tiêu lên sổ.",
        "LSApplicationQueriesSchemes": [
          "zalopay",
          "zalopay.api.v2",
          "momo",
          "tcb",
          "techcombank",
          "vcb",
          "vietcombank",
          "mb",
          "mbbank",
          "vietinbankpay",
          "bidvsmartbanking",
          "vpbankneo",
          "acbone",
          "ocb",
          "tpbank"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "package": "com.kepi.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "NOTIFICATIONS",
        "BIND_NOTIFICATION_LISTENER_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "PigFly cần quyền truy cập camera để bạn chụp lại ảnh khoảnh khắc chi tiêu và nuôi chú heo lớn mỗi ngày."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ],
      "./plugins/withNotificationListener.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
